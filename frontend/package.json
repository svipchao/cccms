{
  "name": "cccms-frontend",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.7.9",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "element-plus": "^2.11.2",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.0",
    "remixicon": "^4.9.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^20.19.43",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.11",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
