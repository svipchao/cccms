# 生产环境配置模板（docker compose 用它，而不是开发用的 .env）
#
#   cp backend/.env.prod.example backend/.env.prod
#   逐项填入真实值后：docker compose up -d
#
# 这里刻意把密钥留空：填错或忘填时，API / 调度器会带着明确的报错直接退出，
# 而不是带着半套默认值跑起来。生成方式：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

# ---- 运行模式 -------------------------------------------------------------
# prod 会启用硬门槛：下面 4 个密钥、COOKIE_SECURE、CORS、管理员口令必须合规。
CCCMS_ENV=prod
CCCMS_DEBUG=false

# ---- 密钥（必填，留空则拒绝启动） ------------------------------------------
# 至少 32 字节；用于会话签名
CCCMS_SECRET_KEY=
# 至少 32 字节；用于 JWT 签名
CCCMS_JWT_SECRET=
# 敏感字段加密母密钥（sys_config 中的密文依赖它，丢了即不可解）
CCCMS_DATA_ENCRYPT_KEY=
# 审计哈希链签名密钥（换了会导致历史链无法校验）
CCCMS_AUDIT_SIGNING_KEY=

# ---- Cookie 与跨域 ---------------------------------------------------------
# 生产必须是 true（HTTPS）
CCCMS_COOKIE_SECURE=true
# 逗号分隔，必须写具体来源，不能含 *
CCCMS_CORS_ORIGINS=https://admin.example.com
# 反代层（nginx/traefik）地址，逗号分隔；不填则只信任直连 IP
CCCMS_TRUSTED_PROXIES=

# ---- 初始管理员（仅在 CLI seed 时使用） ------------------------------------
CCCMS_ADMIN_USERNAME=admin
# 至少 12 位且不能是默认哨兵值 Admin@123456
CCCMS_ADMIN_PASSWORD=
CCCMS_ADMIN_EMAIL=

# ---- 数据库 ---------------------------------------------------------------
CCCMS_DB_HOST=mysql
CCCMS_DB_PORT=3306
CCCMS_DB_NAME=cccms
CCCMS_DB_USER=cccms
CCCMS_DB_PASSWORD=
CCCMS_DB_POOL_SIZE=10
CCCMS_DB_MAX_OVERFLOW=20

# ---- Redis ---------------------------------------------------------------
# 会话、缓存、限流、调度锁都依赖它，建议设置密码或仅内网可达
CCCMS_REDIS_URL=redis://redis:6379/0

# ---- 附件与导出 -----------------------------------------------------------
# 目前只实现 local；其它取值会启动即失败
CCCMS_STORAGE_DRIVER=local
CCCMS_STORAGE_LOCAL_ROOT=/app/shared/uploads
CCCMS_EXPORT_LOCAL_ROOT=/app/shared/exports
CCCMS_UPLOAD_MAX_MB=10

# ---- 可观测性 -------------------------------------------------------------
# /metrics 白名单，支持网段写法；生产不要留 127.0.0.1 以外的默认值无人看管
CCCMS_METRICS_ALLOW_IPS=10.0.0.0/8
CCCMS_HEALTH_DISK_MIN_PERCENT=5

# ---- 在线升级 -------------------------------------------------------------
# 仅本地开发使用，生产保持 false
CCCMS_UPGRADE_ENABLE=false
