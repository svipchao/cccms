# 复制为 .env 后按部署环境修改
CCCMS_ENV=dev
CCCMS_DEBUG=true

# 数据库
CCCMS_DB_HOST=127.0.0.1
CCCMS_DB_PORT=3306
CCCMS_DB_USER=root
CCCMS_DB_PASSWORD=
CCCMS_DB_NAME=cccms

# Redis
CCCMS_REDIS_URL=redis://127.0.0.1:6379/0

# 邮件（SMTP）：找回密码验证码的唯一投递通道
# host 与 from 留空即视为"没有邮件能力"，登录页不会显示"忘记密码"；dev 下验证码改写日志
CCCMS_SMTP_HOST=
CCCMS_SMTP_PORT=587
# starttls(587) / ssl(465) / none(25，仅内网中继；user 非空时凭据会明文过网)
CCCMS_SMTP_SECURITY=starttls
CCCMS_SMTP_USER=
CCCMS_SMTP_PASSWORD=
CCCMS_SMTP_FROM=
CCCMS_SMTP_FROM_NAME=CCCMS
CCCMS_SMTP_TIMEOUT=10

# 安全（dev 留空会自动生成；prod 必须显式配置，至少 32 字节）
# 改密时拒绝「最近 N 次用过的口令」；0 关闭历史校验，1 只拦与当前相同
CCCMS_PASSWORD_HISTORY=5
CCCMS_JWT_SECRET=
CCCMS_DATA_ENCRYPT_KEY=
CCCMS_AUDIT_SIGNING_KEY=
CCCMS_SECRET_KEY=
CCCMS_COOKIE_SECURE=false
# prod 启动硬门槛：DEBUG 必须 false、CORS 不得为空或 *、管理员口令不得为默认值且 ≥12 位

# 文件存储
CCCMS_STORAGE_DRIVER=local
CCCMS_STORAGE_LOCAL_ROOT=../shared/uploads

# 对象存储（S3 兼容）：仅当 CCCMS_STORAGE_DRIVER=s3 时生效，桶与凭据缺失会启动即失败
# endpoint 留空 = AWS 官方端点；MinIO / 自建必须填（驱动固定走 path-style 寻址）
CCCMS_S3_ENDPOINT=
CCCMS_S3_REGION=us-east-1
CCCMS_S3_BUCKET=
CCCMS_S3_ACCESS_KEY=
CCCMS_S3_SECRET_KEY=
# 桶内键前缀：同一个桶给多个环境/租户分目录时用
CCCMS_S3_PREFIX=
CCCMS_STORAGE_URL_PREFIX=/storage
CCCMS_UPLOAD_MAX_MB=10
CCCMS_UPLOAD_CHUNK_MAX_MB=2048
# 导出目录必须在静态资源目录之外，下载走鉴权接口
CCCMS_EXPORT_LOCAL_ROOT=../shared/exports

# 未绑定域名时默认登录租户（需先执行 seed 创建 platform 租户）
CCCMS_LOGIN_DEFAULT_TENANT=platform

# 可信反向代理 IP（用于还原真实客户端 IP）。逗号分隔，也接受 JSON 数组写法。
CCCMS_TRUSTED_PROXIES=

# 初始化管理员（仅 seed 使用）
# 生产必须显式设置 ≥12 位强口令：留空会用内置默认值，启动校验会直接拒绝。
CCCMS_ADMIN_USERNAME=admin
# CCCMS_ADMIN_PASSWORD=ChangeMe-Admin@2026
CCCMS_ADMIN_NICKNAME=Administrator

# 允许跨域的前端地址。逗号分隔，也接受 JSON 数组写法；生产不能含 *
CCCMS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 限流（每分钟）
# 导出任务并发保护（进程内并发 / 单用户未完成任务上限）
CCCMS_EXPORT_MAX_CONCURRENCY=2
CCCMS_EXPORT_MAX_ACTIVE_PER_USER=2

CCCMS_RATELIMIT_API_PER_MIN=60
CCCMS_RATELIMIT_HEAVY_PER_MIN=5
CCCMS_RATELIMIT_ANON_PER_MIN=20
CCCMS_RATELIMIT_ANON_WRITE_PER_MIN=5

# 调度器轮询间隔（秒）
CCCMS_SCHEDULER_POLL_INTERVAL=10

# 在线升级（仅限本地开发，默认关闭）
CCCMS_UPGRADE_ENABLE=false
CCCMS_UPGRADE_BRANCH=main
# 页面未选远端时用的默认远端名（如 origin / cccms / gitee）；不存在则退到仓库唯一的远端
CCCMS_UPGRADE_REMOTE=origin
