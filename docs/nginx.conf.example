# CCCMS 生产 Nginx 样例（同域部署：前端静态 + /api + /storage 反代）
#
# 用法：
#   1. 把 root 改成实际的 frontend/dist 路径；
#   2. proxy_pass 端口与服务端 `config/server.php` 的 listen 保持一致（默认 8787）；
#   3. server_name 与证书按实际域名替换。
#
# 两条**不能删**的约束（见 docs/02 §5.2）：
#   - `/storage/` 必须反代到后端。附件的「公开 / 私有」判定与 nosniff、强制下载都在
#     后端 StorageGuard 中间件里；用 Nginx `root` 直接托管会全部绕过。
#   - 上传目录禁止解析 PHP。即使某天有人把 `public/storage` 挂到了别的 location，
#     也不能让上传的文件被当成脚本执行。
#
# 注意：本项目后端是常驻内存服务（Workerman），不要配 php-fpm / fastcgi。
# 需要 WebSocket 时在 /api 的 location 里补 Upgrade / Connection 两个头。

server {
    listen 80;
    server_name your.domain;

    # 前端构建产物
    root /var/www/cccms/frontend/dist;
    index index.html;

    # 上传/客户端体积上限：后端单文件上限由 upload.max_size（MB）控制，这里留出余量
    client_max_body_size 64m;

    # 安全响应头（按需调整 CSP）
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 带 hash 的静态资源可以长缓存；index.html 不能
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 后端接口
    location /api/ {
        proxy_pass http://127.0.0.1:8787/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # 附件（本地驱动）：**必须**反代到后端，否则「公开 / 私有」开关与响应头加固不生效
    location ^~ /storage/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 兜底：即便反代规则被误改成静态托管，也不允许执行上传目录里的脚本
        location ~ \.(php|php5|phtml|phar)$ {
            deny all;
        }
    }

    # 实时推送（SSE，F9）：独立的推送进程，端口是 config/process.php 里的 realtime_sse（默认 8788）
    #
    # 三条都不能省：
    #   - proxy_buffering off：否则事件会攒在 Nginx 里直到连接结束，页面看着像「没反应」；
    #   - access_log off：令牌在 query 里（EventSource 不能带自定义头），别把它写进访问日志；
    #   - proxy_read_timeout 1h：SSE 是长连接，默认 60s 会被掐断并反复重连。
    #
    # 前端构建时把 VITE_SSE_URL 设为 /sse/stream 即可走这里（https 页面直连 8788 会被当混合内容拦掉）。
    location = /sse/stream {
        access_log off;
        proxy_pass http://127.0.0.1:8788/stream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        chunked_transfer_encoding off;
    }

    # 实时推送（WebSocket，F9 可选通道）：端口是 config/process.php 里的 realtime_ws（默认 8789）
    #
    # 与 SSE 的差别只有握手三件套：proxy_http_version 1.1 + Upgrade + Connection。
    # 缺任何一个浏览器侧都只看到 400，且 nginx 不会给出更具体的提示。
    #
    # 前端构建时 VITE_REALTIME_DRIVER=ws + VITE_WS_URL=/ws/stream 即可走这里。
    location = /ws/stream {
        access_log off;
        proxy_pass http://127.0.0.1:8789/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    # SPA 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}
