# =====================================================================
# CCCMS 环境变量示例
#
# 用法：复制为 .env 后按环境修改（.env 已被 .gitignore 忽略，不会提交）。
#   cp .env.example .env
#
# Webman 启动时会自动加载 .env 到环境变量，配置文件中用 getenv() 读取。
# 生产环境请务必替换 JWT_SECRET 与 DATA_ENCRYPT_KEY。
# =====================================================================

# ---- 应用 ----
# 异常详情开关。**默认 false = 安全值**：异常只回「服务器内部错误」，不把堆栈 / SQL 抛给前端。
# 生产务必保持 false；只有本地开发想看到具体报错时才改成 true。
APP_DEBUG=false

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cccms
DB_USERNAME=root
DB_PASSWORD=123456
# 是否在日志中输出 SQL 调试信息（生产关闭）
DB_DEBUG=false
# PDO 建连超时（秒），网络/MySQL 抖动时快速失败，默认 5
DB_CONNECT_TIMEOUT=5
# 长连接心跳间隔（秒），默认 30；需小于 MySQL wait_timeout 与代理空闲回收时间，填 0 关闭。
# 作用：定时对进程内已建立的连接执行 SELECT 1，避免空闲连接被服务端掐断后业务报
#      「2006 MySQL server has gone away」。
DB_HEARTBEAT_INTERVAL=30
# mysqldump 可执行文件（定时备份 / 手工备份优先用它，失败回退纯 PDO 导出）。
# 不在 PATH 里时写绝对路径，例如 /usr/bin/mysqldump 或 C:\php\mysqldump.exe
#MYSQLDUMP_BIN=mysqldump

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 鉴权（必填：不配置将无法启动）----
# HS256 要求密钥 >= 32 字节，建议用随机串：php -r "echo bin2hex(random_bytes(32));"
# 启动期 SecurityBootstrap 会强校验：未填写 / 不足 32 字节 / 等于旧版公开示例值都会直接拒绝启动。
JWT_SECRET=
# 字段级 encrypt 动作的 AES-256-GCM 种子。
# 注意：**不做密钥轮换**，一旦更换，历史加密字段将无法解密。
DATA_ENCRYPT_KEY=

# ---- 审计链签名（v2 起必需）----
# `sys_log` 的 `row_hash` 由无密钥 sha256 改为 HMAC-SHA256，密钥取这里。
# 为什么需要：无密钥哈希挡不住「有库权限的人」—— 他改完一行可以把后续行全部重算，
# 链校验照样通过；密钥不在库里，这条重算路径才被堵死。
# 未配置时：写入**降级**为普通插入（日志不丢、但该行不入链），降级次数见 /metrics 的
#          cccms_logchain_degraded_total；生产环境由 SecurityBootstrap 拒绝启动。
# 生成：php -r "echo bin2hex(random_bytes(32));"
AUDIT_SIGNING_KEY=

# ---- 存储 ----
# 初始驱动 local | oss | cos | qiniu；建库后以后台「配置管理 → 上传」的 upload.storage_driver 为准。
# 云存储凭证（AK/SK、bucket、endpoint/region、domain）不在 .env 配置，
# 统一在后台「配置管理 → 上传」填写，选中哪个驱动就只显示那一个驱动的字段。
STORAGE_DRIVER=local

# ---- 数据权限检查（可选，cccms:data-scope-check）----
# 业务插件表（不带 sys_ 前缀）豁免名单：完整表名，英文逗号分隔。
# 未登记受控表、也没有 tenant_id 列的插件表默认会被检查判为 error（P1-1 方案 B）；
# 确实不需要隔离的表（纯字典 / 归档 / 外部同步游标）写在这里，等于声明「接受跨租户可见」。
#DATA_SCOPE_EXEMPT_TABLES=ks_sync_cursor,ks_import_staging

# ---- 实时推送（可选）----
# SSE / WebSocket 通道监听端口；改动后要同步 Nginx 反代与前端拼地址的逻辑（config/realtime.php）。
# 多实例部署时每台机器都要能监听这两个端口，或统一改到同一组对外端口。
#CCCMS_SSE_PORT=8788
#CCCMS_WS_PORT=8789

# ---- 跨域（可选）----
# 逗号分隔的来源白名单，命中才下发 CORS 头（HTTP 接口与 SSE 推送共用这一份）。
# 留空 = 只允许同源（前后端同域部署 / Nginx 反代都无需配置）。
# 例外：**本地开发要填**。页面在 Vite 的 5173，SSE 推送直连 8788，属于跨域；
# 不放行的话 EventSource 报 `net::ERR_FAILED 200 (OK)`（curl 直连看不出问题）。
#   CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 仅前后端**分域部署**时按实际域名填写，例如：
#   CORS_ORIGIN=https://admin.example.com,https://ops.example.com
CORS_ORIGIN=

# ---- 日志归档（可选，cccms:log-archive / LogArchiveTask）----
# 归档「创建时间早于 N 天」的记录；命令还会强制下限 7 天
LOG_ARCHIVE_DAYS=30
# 每批处理条数，避免一次把全表拉进内存
LOG_ARCHIVE_BATCH=1000
# 归档目标驱动：留空 = 跟随 STORAGE_DRIVER（local | oss | cos | qiniu）
LOG_ARCHIVE_DRIVER=
# 对象存储路径前缀
LOG_ARCHIVE_PATH=log-archive

# ---- 上游代码同步 / 自动升级（可选，cccms:update / 后台「系统设置 → 自动升级」）----
# ⚠️ **仅限本地开发环境**：线上前端已构建（产物在 public 下）、目录结构与仓库不一致，
# 按仓库相对路径覆盖会改坏线上代码。除总开关外还有一道目录自检（仓库根需存在
# frontend/package.json），线上即使打开开关也会被自动拦住。
# 同步源：gitee（国内镜像，默认）| github（国外）。公开仓库可直接匿名拉取，无需任何凭据。
CCCMS_UPGRADE_SOURCE=gitee
# 私有仓库 / 需认证的源，把令牌写进 URL 即可（接口响应与报错里的 URL 会自动打码）
#CCCMS_UPGRADE_URL_GITEE=https://<账号>:<令牌>@gitee.com/poetryiii/cccms.git

# 跟踪的版本：分支名 / tag / commit（默认 main）
#CCCMS_UPGRADE_TRACK=main
# 基线版本：首次初始化时记录「当前代码基于的上游版本」（默认 v0.0.1）
#CCCMS_UPGRADE_BASE=v0.0.1
# git 可执行文件（不在 PATH 里时写绝对路径）
#CCCMS_UPGRADE_GIT=/usr/bin/git
# 总开关：默认关闭（false），只在本地开发环境打开；线上保持关闭
#CCCMS_UPGRADE_ENABLE=true

# ---- 代码生成器（可选，后台「开发工具 → 代码生成」）----
# ⚠️ **仅限本地开发环境**：生成器会直接写 server/ 与 frontend/ 下的 PHP / TS / Vue 文件，
# 与上游同步同级风险。同样有两道闸：目录自检（仓库根需存在 frontend/package.json）
# + 本开关。任一不过，四个生成器接口一律 403。
# 需要本地调试代码生成时取消下面一行注释：
#CCCMS_GENERATOR_ENABLE=true
