# PHPStan 静态分析配置（R-09）
#
# 为什么**只扫 `plugin/cccms`**：本仓库是「框架基础 + 业务插件」结构，`plugin/cccms` 是
# 随仓库维护的框架级基础功能；业务插件（`plugin/*`，含代码生成器产出的）由使用方各自维护，
# 不在本仓库的分析范围内。
#
# 为什么 level 5 起步 + baseline：历史代码一次性清零会淹没本次改造，而且其中相当一部分是
# 「think-orm / webman 的魔术方法」这类静态分析天然误报的位置。baseline 把既有问题冻结成清单，
# 保证**新增代码不得新增条目**；后续按模块逐步删减条目即可把 level 提上去。
includes:
    # 「既有问题」冻结清单。**新增代码不得往里面加条目** —— 需要忽略时，
    # 优先在代码里改（如补类型标注），其次在下面 ignoreErrors 里写**带理由**的精确规则。
    # 修改代码后若 baseline 条目不再命中，无需重生成（见 reportUnmatchedIgnoredErrors）。
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - plugin/cccms

    # PHP 内置函数 / webman 助手函数的返回类型标注不总是可信（如 `config()` 返回 mixed），
    # 据此推断出的报错噪音大，故关闭「把 PHPDoc 类型当成确定事实」。
    treatPhpDocTypesAsCertain: false

    # baseline 是「既有问题」的冻结清单，条目可能随代码修复而失效（不再匹配）。
    # 不让「清单里有条不再命中」变成新的报错，否则每次修 bug 都要重生成 baseline。
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # `/healthz`、`/metrics` 与分片上传的支撑类直接读表 / 读缓存（探活必须问真实的库与缓存，
        # 走模型层反而会被租户/数据权限作用域干扰）。think-orm 与 webman 的 facade 都是
        # `__callStatic` 转发，PHPStan 看不到这些方法 —— 既有代码的同类报错已冻结在 baseline，
        # 新增代码按「框架边界」在这里显式放行，而不是往 baseline 里再加条目。
        -
            identifier: staticMethod.notFound
            paths:
                - plugin/cccms/support/HealthProbe.php
                - plugin/cccms/support/Metrics.php
                - plugin/cccms/support/ChunkUpload.php
                # 审计链的列就绪检查（information_schema）与 db-upgrade 的增量 ALTER：
                # think-orm 的 query/execute 同样是 __callStatic 转发，静态分析看不到。
                - plugin/cccms/support/LogChain.php
                - plugin/cccms/command/DbUpgradeCommand.php
                # 插件表检查（R3）查 information_schema，判断插件表是否已有 tenant_id 列
                - plugin/cccms/support/DataScopeChecker.php

        # `Redis::setex()` 同样是 facade 的 `__callStatic` 转发（调度进程心跳）。
        -
            identifier: staticMethod.notFound
            message: '#Redis::setex\(\)\.$#'
            paths:
                - plugin/cccms/support/CrontabRunner.php

        # think-orm 的 `withTrashed()` 是**查询入口**，按静态方式调用（`Model::withTrashed()`）
        # 是官方用法，静态分析把它当实例方法。既有调用点按文件计数冻结在 baseline，
        # 新增一个调用点就会「期望 1 次实际 2 次」式地飘红，因此按方法名统一放行。
        -
            identifier: method.staticCall
            message: '#withTrashed\(\)\.$#'

        # Webman 的 Request 由中间件在运行时挂载动态属性（`$user` / `$jti` / `$traceId` /
        # `$controller` / `$action` 等），静态分析看不到这些属性。既有代码的同类报错
        # 冻结在 baseline（且按文件计数，新增一个控制器就会"期望 1 次实际 4 次"式地飘红），
        # 因此在这里按「框架边界」统一放行，后续新控制器读这些属性不会再新增 baseline 条目。
        -
            identifier: property.notFound
            message: '#^Access to an undefined property Webman\\Http\\Request::\$#'
