{
  "name": "cccms/cccms",
  "type": "project",
  "license": "MIT",
  "description": "CCCMS 后台管理系统：Webman 服务端（插件化架构 + RBAC + 数据权限 + 审计链）。",
  "keywords": [
    "cccms",
    "admin",
    "webman",
    "rbac"
  ],
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "topthink/think-orm": "^4.0",
    "webman/redis": "^2.1",
    "firebase/php-jwt": "^7.1",
    "webman/console": "^2.2",
    "workerman/crontab": "^1.0",
    "qcloud/cos-sdk-v5": "^2.6",
    "aliyuncs/oss-sdk-php": "^2.7",
    "qiniu/php-sdk": "^7.14",
    "predis/predis": "^3.6",
    "vlucas/phpdotenv": "^5.6"
  },
  "suggest": {
    "ext-event": "For better performance. ",
    "ext-redis": "phpredis 扩展（未安装时自动回退 predis）"
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php support/vendor_patch.php"
    ],
    "test": [
      "php tests/run.php"
    ],
    "analyse": [
      "phpstan analyse --memory-limit=1G"
    ],
    "cs:check": [
      "php-cs-fixer fix --dry-run --diff --using-cache=no"
    ],
    "cs:fix": [
      "php-cs-fixer fix"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}
