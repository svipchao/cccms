{
  "name": "workerman/webman",
  "type": "project",
  "keywords": [
    "high performance",
    "http service"
  ],
  "homepage": "https://www.workerman.net",
  "license": "MIT",
  "description": "High performance HTTP Service Framework.",
  "authors": [
    {
      "name": "walkor",
      "email": "walkor@workerman.net",
      "homepage": "https://www.workerman.net",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "walkor@workerman.net",
    "issues": "https://github.com/walkor/webman/issues",
    "forum": "https://wenda.workerman.net/",
    "wiki": "https://workerman.net/doc/webman",
    "source": "https://github.com/walkor/webman"
  },
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "topthink/think-orm": "^4.0",
    "webman/redis": "^2.1",
    "firebase/php-jwt": "^7.1",
    "webman/console": "^2.2",
    "workerman/crontab": "^1.0",
    "qcloud/cos-sdk-v5": "^2.6",
    "aliyuncs/oss-sdk-php": "^2.7",
    "qiniu/php-sdk": "^7.14",
    "predis/predis": "^3.6",
    "vlucas/phpdotenv": "^5.6"
  },
  "suggest": {
    "ext-event": "For better performance. ",
    "aliyuncs/oss-sdk-php": "阿里云 OSS 存储驱动（后台配置管理 → 上传，驱动选 oss）",
    "qcloud/cos-sdk-v5": "腾讯云 COS 存储驱动（后台配置管理 → 上传，驱动选 cos）",
    "qiniu/php-sdk": "七牛云 Kodo 存储驱动（后台配置管理 → 上传，驱动选 qiniu）"
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php support/vendor_patch.php"
    ],
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ],
    "test": [
      "php tests/run.php"
    ],
    "analyse": [
      "phpstan analyse --memory-limit=1G"
    ],
    "cs:check": [
      "php-cs-fixer fix --dry-run --diff --using-cache=no"
    ],
    "cs:fix": [
      "php-cs-fixer fix"
    ],
    "post-create-project-cmd": [
      "support\\Setup::run"
    ],
    "setup-webman": [
      "support\\Setup::run"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}
