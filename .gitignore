# 依赖与虚拟环境
backend/.venv/
node_modules/

# Python 缓存与检查产物
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 本地配置与密钥：backend/.env 含 JWT/数据加密/审计签名密钥与数据库口令，
# backend/.dev-secrets.env 是 dev 自动生成的密钥落盘文件，两者都不得入库。
# （backend/.env.example 是模板，必须入库。）
backend/.env
backend/.dev-secrets.env
backend/.dev-secrets.lock
backend/.dev-secrets.tmp

# 运行时数据
shared/uploads/
shared/exports/
shared/quarantine/
backups/
*.log

# 前端构建产物与测试覆盖
dist/
coverage/
